# Monad testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_WS_URL=wss://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_WS_URL=wss://testnet-rpc.monad.xyz

# Contracts: deployer key, testnet only, never commit
DEPLOYER_PRIVATE_KEY=

# Web drip API: funds burner wallets, testnet only, never commit
DRIP_PRIVATE_KEY=
DRIP_AMOUNT_MON=0.3
# Drip rate caps per minute (review C4). Defaults 60 per client IP (carrier NAT puts many
# phones behind one IPv4) and 300 overall; the global cap bounds the faucet drain rate.
DRIP_MAX_PER_MINUTE_PER_IP=60
DRIP_MAX_PER_MINUTE_GLOBAL=300
# distinct players the drip funds per session (0 = no cap); over it the phone says "The room is full".
DRIP_MAX_PLAYERS_PER_SESSION=20
# Crowd simulator (scripts crowd): off unless 1. Off hides the host bar's Add/Stop crowd and refuses /api/crowd/start.
NEXT_PUBLIC_CROWD_ENABLED=
# the tip page's own drip (POST /api/drip { address, mode: "tipper", sessionId }), counted apart
# from the player caps; defaults and meaning in apps/web/README.md. Tip notes are kept off-chain in a JSON file.
TIP_DRIP_AMOUNT_MON=0.1
TIP_DRIP_MAX_PER_MINUTE_PER_IP=20
TIP_DRIP_MAX_PER_MINUTE_GLOBAL=60
TIP_DRIP_MAX_TOTAL=150
TIP_DRIP_MAX_PER_SESSION=50
TIP_DRIP_MAX_PER_IP_PER_SESSION=25
TIP_NOTE_MAX_PER_MINUTE_PER_IP=30
TIP_NOTE_MAX_PER_MINUTE_GLOBAL=600
TIP_NOTES_FILE=.data/tip-notes.json
# Top-ups: POST /api/drip { address, topUp: true } sends DRIP_AMOUNT_MON again to a wallet this
# server funded, only below 0.03 MON, at most 2 per wallet per server lifetime, inside the caps above.

# Public address of the resident DJ agent wallet; stage colours its hits differently
NEXT_PUBLIC_AGENT_ADDRESS=0x2222222222222222222222222222222222222222

# Web runtime
# Force mock mode (in-memory simulator, nothing on chain). On Monad testnet the app REFUSES
# to boot with a zero contract address unless this is 1 (review C1); on anvil a zero address
# still falls back to mock mode.
NEXT_PUBLIC_BLOCKBEAT_MOCK=
# apps/web/test/smoke-hit.ts: funded testnet key and target (never commit)
PRIVATE_KEY=
SESSION_ID=1
TRACK=0
NOTE=0

# Chain selection. Default 10143 (Monad testnet); 31337 runs against a local anvil.
NEXT_PUBLIC_CHAIN_ID=10143
# Overrides the shared address table for the selected chain (required on anvil; read the
# address from the `forge script ... --broadcast` output).
NEXT_PUBLIC_BLOCKBEAT_ADDRESS=
# Host key used by app/api/session/start and app/api/session/finalize (server only, never commit)
HOST_PRIVATE_KEY=
# Shared secret the presenter enters on /host; sent as the x-blockbeat-host header to the session routes
HOST_SECRET=
# Stage DJ: /api/agent/start spawns `pnpm --filter agent start` from the repo root, which is
# two levels above apps/web unless set here. The agent reads apps/agent/.env; the web keys are not passed on.
BLOCKBEAT_REPO_ROOT=
# note decay. Every hit is a note that lives this many bars (16 blocks each; 8 = 128 blocks ≈ 38 s)
# after its most recent hit, on the stage, the phones and the DJ. 0 = no decay: everything plays the
# contract's recorded pattern (the XOR bitmask), exactly as before. Read at build time by Next
# (restart `next dev` / rebuild after a change) and passed to the stage-spawned DJ.
NEXT_PUBLIC_NOTE_LIFETIME_BARS=8
# voice cap: at most this many live notes per track, the newest win (6 × 8 tracks = 48 of 128
# cells). 0 = no cap. Same rules as above.
NEXT_PUBLIC_MAX_LIVE_PER_TRACK=6
# Public base URL for the join QR on the stage (e.g. a cloudflared tunnel); defaults to the page origin
NEXT_PUBLIC_JOIN_BASE_URL=
# Playwright: set to 1 to run e2e/anvil-flow.spec.ts against a running anvil + dev server
BLOCKBEAT_E2E_ANVIL=

# scripts/: load test, fund-drip and session ops
# Funder for the load test burners; falls back to DRIP_PRIVATE_KEY (env or ~/.blockbeat/keys.env)
# and to anvil account 0/1 on chain 31337. Never commit.
FUNDER_PRIVATE_KEY=
# Override the contract address from packages/shared (e.g. a local anvil deployment)
BLOCKBEAT_ADDRESS=

# Resident DJ agent (apps/agent). Copy the relevant lines to apps/agent/.env (gitignored).
# Chain: 10143 (Monad testnet, default) or 31337 (local anvil)
AGENT_CHAIN_ID=10143
AGENT_RPC_URL=https://testnet-rpc.monad.xyz
AGENT_WS_URL=wss://testnet-rpc.monad.xyz
# BLOCKBEAT_ADDRESS above also applies to the agent (required on anvil)
# Agent wallet key (address 0x2222222222222222222222222222222222222222 on testnet). Never commit.
AGENT_PRIVATE_KEY=
# Brain: the DJ runs on OpenAI gpt-6-luna with reasoning effort none (p50 1.3 s, p95 2.3 s on
# the DJ prompt). AGENT_BRAIN=anthropic|openai|gemini|rules; unset = anthropic if ANTHROPIC_API_KEY, else
# openai if OPENAI_API_KEY, else gemini, else rules. A bar the LLM misses (deadline, 429/5xx after one
# retry, 4xx) plays the rules; the status line says why ("brain rules (openai timeout)"), never the key.
# Empty picks openai whenever OPENAI_API_KEY is set; AGENT_BRAIN=openai makes a missing key a startup error.
AGENT_BRAIN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh ('minimal' is rejected for luna). Empty = none for gpt-6-luna.
OPENAI_REASONING_EFFORT=none
# Empty = 4000 ms for openai / gemini, 3000 ms for anthropic (the loop plans the next bar, 4.8 s ahead).
AGENT_LLM_TIMEOUT_MS=
# Optional: Claude (AGENT_MODEL) or the dormant Gemini brain (GEMINI_API_KEY, GEMINI_MODEL, GEMINI_RPM; see
# docs/evidence/w14-gemini-brain).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM=
# Kill switch: false keeps the loop and status line running but sends nothing
AGENT_ENABLED=true
# the DJ plays a phrase (up to AGENT_MAX_NOTES_PER_BAR notes, 0..8) per bar in a 20-bar set:
# intro 4, build 4, peak 8, breakdown 4, in AGENT_KEY (default "A minor", Am-F-C-G in every bar).
# ~45 hits per cycle in an empty room: 160 hits ~ 6 minutes ~ 1.6 MON (0.02 first hit, 0.01 after).
AGENT_MAX_HITS_PER_SESSION=160
AGENT_MAX_NOTES_PER_BAR=8
AGENT_KEY=A minor
# Open the set on another arrangement bar (0 intro, 4 build, 8 peak, 16 breakdown)
AGENT_SET_START_BAR=
# 1 = log the raw LLM answer each bar (model output only; keys are never logged)
AGENT_DEBUG_LLM=
# Override per run with AGENT_SESSION_ID=<id> pnpm --filter agent start, or
# pnpm --filter agent start -- --session <id> (review M9)
AGENT_SESSION_ID=1
# Optional: stop after N bars (evidence runs); empty runs until Ctrl-C
AGENT_BARS=
# Optional: print the text grid under each status line
AGENT_SHOW_GRID=
# Optional: ERC-8004 identity registry override (default: the docs.monad.xyz address, skipped when it has no code)
ERC8004_IDENTITY_REGISTRY=
# Where the registered agent id is persisted (gitignored)
AGENT_STATE_PATH=.agent.json
# Evidence helpers (apps/agent/scripts): funded key for seeding human hits on anvil, e.g. anvil account 1
SEED_PRIVATE_KEY=
SEED_SESSION_ID=
SEED_BARS=1
TICK_MS=300
# crowd simulator started from the host bar ("Add 10 players"): MON budget per run passed to
# `crowd --max-mon` (the script's default is 1.5, its ceiling 5). The crowd reads the drip key itself.
CROWD_MAX_MON=1.5
