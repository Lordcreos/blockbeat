# Resident DJ agent. Copy to apps/agent/.env (gitignored). Same variables as the agent block in the root .env.example.
AGENT_CHAIN_ID=10143
AGENT_RPC_URL=https://testnet-rpc.monad.xyz
AGENT_WS_URL=wss://testnet-rpc.monad.xyz
# Required on anvil (overrides packages/shared for the selected chain)
BLOCKBEAT_ADDRESS=
# 0x-prefixed 32-byte hex. Never commit a real key.
AGENT_PRIVATE_KEY=
# Brain: the DJ runs on OpenAI gpt-6-luna with reasoning effort none (p50 1.3 s, p95 2.3 s on
# the DJ prompt). AGENT_BRAIN=anthropic|openai|gemini|rules; unset = anthropic if ANTHROPIC_API_KEY, else
# openai if OPENAI_API_KEY, else gemini, else rules. A bar the LLM misses (deadline, 429/5xx after one
# retry, 4xx) plays the rules; the status line says why ("brain rules (openai timeout)"), never the key.
# Empty picks openai whenever OPENAI_API_KEY is set; AGENT_BRAIN=openai makes a missing key a startup error.
AGENT_BRAIN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh ('minimal' is rejected for luna). Empty = none for gpt-6-luna.
OPENAI_REASONING_EFFORT=none
# Empty = 4000 ms for openai / gemini, 3000 ms for anthropic (the loop plans the next bar, 4.8 s ahead).
AGENT_LLM_TIMEOUT_MS=
# Optional: Claude (AGENT_MODEL) or the dormant Gemini brain (GEMINI_API_KEY, GEMINI_MODEL, GEMINI_RPM; see
# docs/evidence/w14-gemini-brain).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM=
AGENT_ENABLED=true
# note decay, the same knobs the stage reads (the stage passes its own values to a DJ it
# spawns). Notes live 8 bars after their last hit; at most 6 live notes per track. 0 = off.
NEXT_PUBLIC_NOTE_LIFETIME_BARS=8
NEXT_PUBLIC_MAX_LIVE_PER_TRACK=6
# the DJ plays a phrase (up to AGENT_MAX_NOTES_PER_BAR notes, 0..8) per bar in a 20-bar set:
# intro 4, build 4, peak 8, breakdown 4, in AGENT_KEY (default "A minor", Am-F-C-G in every bar).
# ~45 hits per cycle in an empty room: 160 hits ~ 6 minutes ~ 1.6 MON (0.02 first hit, 0.01 after).
AGENT_MAX_HITS_PER_SESSION=160
AGENT_MAX_NOTES_PER_BAR=8
AGENT_KEY=A minor
# Open the set on another arrangement bar (0 intro, 4 build, 8 peak, 16 breakdown)
AGENT_SET_START_BAR=
# 1 = log the raw LLM answer each bar (model output only; keys are never logged)
AGENT_DEBUG_LLM=
# Session to play. The value here goes stale by design (the pitch session is created minutes
# before). Override it without editing this file, either way (review M9):
#   AGENT_SESSION_ID=<id> pnpm --filter agent start      (process env wins; dotenv never overrides it)
#   pnpm --filter agent start -- --session <id>          (command line wins over both)
#   or press Start DJ on the stage: it sets AGENT_SESSION_ID and an empty AGENT_BARS for the child it spawns
AGENT_SESSION_ID=1
# Optional: stop after N bars; print the grid each bar
AGENT_BARS=
AGENT_SHOW_GRID=
ERC8004_IDENTITY_REGISTRY=
AGENT_STATE_PATH=.agent.json
# scripts/seed-session.ts and scripts/anvil-ticker.ts (local anvil only)
SEED_PRIVATE_KEY=
SEED_SESSION_ID=
SEED_BARS=1
TICK_MS=300
